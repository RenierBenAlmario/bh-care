@page
@model Barangay.Pages.Doctor.CreateNCDAssessmentModel
@{
    ViewData["Title"] = "Create NCD Risk Assessment";
    Layout = "_DoctorLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Create NCD Risk Assessment</h2>
        <a href="/Doctor/Consultation?id=@Model.Assessment.AppointmentId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Consultation
        </a>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Patient: @Model.PatientName</h5>
        </div>
        <div class="card-body">
            <form method="post" id="ncdForm">
                <div class="mb-3">
                    <div class="progress" style="height: 8px;">
                        <div id="wizardProgress" class="progress-bar bg-primary" role="progressbar" style="width: 20%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mt-1">
                        <span>1. Demographics</span>
                        <span>2. Medical</span>
                        <span>3. Family</span>
                        <span>4. Risk</span>
                        <span>5. Measurements</span>
                        <span>6. Assessment</span>
                    </div>
                </div>
                <input type="hidden" asp-for="Assessment.AppointmentId" />
                <input type="hidden" asp-for="Assessment.Id" />
                <input type="hidden" asp-for="Assessment.UserId" />
                <input type="hidden" asp-for="Assessment.Birthday" />
                <input type="hidden" asp-for="Assessment.Edad" value="@Model.PatientAge" />
                
                <!-- Step 1: Demographics -->
                <div class="wizard-step" data-step="1">
                    <h4 class="mb-3">Part I. Demographic-Socio-Economic Profile</h4>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Health Facility</label>
                                <input type="text" asp-for="Assessment.HealthFacility" class="form-control" value="@Model.HealthFacility" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Family Number</label>
                                <input type="text" asp-for="Assessment.FamilyNo" class="form-control" value="@Model.FamilyNo" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">ID Number</label>
                                <input type="text" asp-for="Assessment.IDNumber" class="form-control" />
                            </div>
                            
                            <!-- ADD: Additional ID Field -->
                            <div class="form-group mb-3">
                                <label class="form-label">ID No.</label>
                                <input type="text" asp-for="Assessment.IDNo" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">First Name</label>
                                <input type="text" asp-for="Assessment.FirstName" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Middle Name</label>
                                <input type="text" asp-for="Assessment.MiddleName" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Last Name</label>
                                <input type="text" asp-for="Assessment.LastName" class="form-control" />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Date of Assessment</label>
                                <input type="date" asp-for="Assessment.DateOfAssessment" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Address</label>
                                <input type="text" asp-for="Assessment.Address" class="form-control" value="@Model.PatientAddress" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Barangay</label>
                                <input type="text" asp-for="Assessment.Barangay" class="form-control" value="@Model.PatientBarangay" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Phone</label>
                                <input type="text" asp-for="Assessment.Telepono" class="form-control" value="@Model.PatientPhone" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Age</label>
                                <input type="text" asp-for="Assessment.Edad" class="form-control" value="@Model.PatientAge" readonly />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Gender</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Assessment.Kasarian" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Assessment.Kasarian" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Religion</label>
                                <input type="text" asp-for="Assessment.Relihiyon" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Occupation</label>
                                <input type="text" asp-for="Assessment.Occupation" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Civil Status</label>
                                <input type="text" asp-for="Assessment.CivilStatus" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Risk Status</label>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasDiabetes" value="true" />
                                    <label class="form-check-label">DM</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasHypertension" value="true" />
                                    <label class="form-check-label">HPN</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasCancer" value="true" />
                                    <label class="form-check-label">Cancer (specify site)</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasCOPD" value="true" />
                                    <label class="form-check-label">COPD</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Step 2: Medical History -->
                <div class="wizard-step d-none" data-step="2">
                    <h4 class="mb-3">Part II. Past Medical History</h4>
                    <div class="mb-4">
                        <h6>Mayroon ba ay may sumusunod nakaraang karamdaman?</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasDiabetes" value="true" />
                                    <label class="form-check-label">Diabetes</label>
                                </div>
                                <div id="diabetesFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.DiabetesYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.DiabetesMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasHypertension" value="true" />
                                    <label class="form-check-label">Hypertension</label>
                                </div>
                                <div id="hypertensionFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.HypertensionYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.HypertensionMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasCancer" id="hasCancer" value="true" />
                                    <label class="form-check-label">Cancer</label>
                                </div>
                                <div id="cancerTypeDiv" class="mb-2 d-none">
                                    <input type="text" asp-for="Assessment.CancerType" class="form-control form-control-sm" placeholder="Cancer type" />
                                    <div class="mt-2"></div>
                                    <input type="text" asp-for="Assessment.CancerYear" class="form-control form-control-sm mt-2" placeholder="Year Diagnosed" />
                                    <input type="text" asp-for="Assessment.CancerMedication" class="form-control form-control-sm mt-2" placeholder="Medication" />
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasLungDisease" value="true" />
                                    <label class="form-check-label">Sakit sa baga na hindi nakakahawa</label>
                                </div>
                                <div id="lungDiseaseFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.LungDiseaseYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.LungDiseaseMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <!-- ADD: Eye Disease Section -->
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasEyeDisease" value="true" />
                                    <label class="form-check-label">Sakit sa mata</label>
                                </div>
                                <div id="eyeDiseaseFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.EyeDiseaseYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="Assessment.EyeDiseaseMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <!-- ADD: Additional Medical Conditions -->
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasAsthma" value="true" />
                                    <label class="form-check-label">Asthma</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasDifficultyBreathing" value="true" />
                                    <label class="form-check-label">Has Difficulty Breathing</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Pananaklit ng dibdib (Chest pain)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.HasChestPain" value="true" />
                            <label class="form-check-label">Pananakit/kabigatan sa dibdib</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.ChestPainSpreadsToArm" value="true" />
                            <label class="form-check-label">May kumakalat na sakit hanggang braso</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.NumbnessWhenWalkingFast" value="true" />
                            <label class="form-check-label">Pamamanhid kapag nagmamadali/naglalakad ng mabilis</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.PainRelievedWithRest" value="true" />
                            <label class="form-check-label">Nawawala ang sakit kapag nakapahinga</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.LossOfConsciousnessLessThan10Min" value="true" />
                            <label class="form-check-label">Nawawalan ng malay <10 minuto</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.PainLastsMoreThan30Min" value="true" />
                            <label class="form-check-label">Sakit tumatagal >30 minuto</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.SeeDoctorIfYes" value="true" />
                            <label class="form-check-label">Kung Oo, magpatingin agad sa doktor</label>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Doktor</label>
                            <input type="text" asp-for="Assessment.DoctorName" class="form-control" />
                        </div>
                    </div>
                </div>
                
                <!-- Step 3: Family History -->
                <div class="wizard-step d-none" data-step="3">
                    <h4 class="mb-3">Part III. Assessment of Risk Factors</h4>
                    <h5 class="mb-3">A. Non-Modifiable Risk Factors</h5>
                    <div class="mb-4">
                        <h6>Sakit sa pamilya (Family history):</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasHypertension" value="true" />
                                    <label class="form-check-label">Hypertension</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasDiabetes" value="true" />
                                    <label class="form-check-label">Diabetes</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasStroke" value="true" />
                                    <label class="form-check-label">Stroke</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasCancer" value="true" />
                                    <label class="form-check-label">Cancer</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasKidneyDisease" value="true" />
                                    <label class="form-check-label">Sakit sa bato</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FamilyHasOtherDisease" value="true" />
                                    <label class="form-check-label">Other Disease</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Isulat: (Other disease details)</label>
                            <input type="text" asp-for="Assessment.FamilyOtherDiseaseDetails" class="form-control" />
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" />
                            <label class="form-check-label">First degree relatives</label>
                        </div>
                    </div>
                </div>
                
                <!-- Step 4: Modifiable Risk Factors -->
                <div class="wizard-step d-none" data-step="4">
                    <h5 class="mb-3">B. Modifiable Risk Factors</h5>
                    
                    <div class="mb-4">
                        <h6>Nutrisyon (Nutrition):</h6>
                        <p>Madalas mo bang kainin kada araw?</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsVegetablesDaily" value="true" />
                                    <label class="form-check-label">Gulay</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsFruitsDaily" value="true" />
                                    <label class="form-check-label">Prutas</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsFishDaily" value="true" />
                                    <label class="form-check-label">Isda</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsMeatDaily" value="true" />
                                    <label class="form-check-label">Karne</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasUnhealthyDiet" value="true" />
                                    <label class="form-check-label">Unhealthy Diet</label>
                                </div>
                            </div>
                        </div>
                        
                        <p>Kumakain ka ba ng higit sa 2 beses kada linggo ng:</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsFattyFoodMoreThan2TimesPerWeek" value="true" />
                                    <label class="form-check-label">Matatabang pagkain</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsSweetFoodMoreThan2TimesPerWeek" value="true" />
                                    <label class="form-check-label">Matatamis na pagkain</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.EatsOilyFoodMoreThan2TimesPerWeek" value="true" />
                                    <label class="form-check-label">Mamantikang pagkain</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasHighSaltIntake" value="true" />
                                    <label class="form-check-label">With high salt intake</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Alakhol (Alcohol):</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.DrinksAlcohol" value="true" />
                            <label class="form-check-label">Umiinom ka ba ng alak? Oo</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Hindi</label>
                        </div>
                        
                        <p>Kung Oo:</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.DrinksBeer" value="true" />
                                    <label class="form-check-label">Beer</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.DrinksWine" value="true" />
                                    <label class="form-check-label">Wine</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.DrinksWhiskyGinBrandy" value="true" />
                                    <label class="form-check-label">Whisky/Gin/Brandy</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholAmount1Bottle320ml" value="true" />
                                    <label class="form-check-label">1 bote (320 ml)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholAmount2Bottle640ml" value="true" />
                                    <label class="form-check-label">2 bote (640 ml)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholAmountLessThan3Shot45ml" value="true" />
                                    <label class="form-check-label"><3 shot/jigger (45 ml)</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholAmount3to4WineGlasses300ml" value="true" />
                                    <label class="form-check-label">3–4 wine glasses (300 ml)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholAmountMoreThan4Shots75ml" value="true" />
                                    <label class="form-check-label">>4 shots/jigger (75 ml)</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholFrequency1to3TimesPerWeek" value="true" />
                                    <label class="form-check-label">1–3 beses/linggo</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.AlcoholFrequencyMoreThan4TimesPerWeek" value="true" />
                                    <label class="form-check-label">≥4 beses/linggo</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.IsBingeDrinker" value="true" />
                            <label class="form-check-label">Binge Drinker</label>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Ehersisyo (Physical Activity):</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.ModerateIntensityExercise" value="true" />
                                    <label class="form-check-label">Moderate Intensity</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.VigorousIntensityExercise" value="true" />
                                    <label class="form-check-label">Vigorous Intensity</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.CombinationExercise" value="true" />
                                    <label class="form-check-label">Kombinasyon</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.InsufficientPhysicalActivity" value="true" />
                                    <label class="form-check-label">Insufficient Physical Activity</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Paninigarilyo (Smoking):</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.FormerSmoker" value="true" />
