                    </div>
                    
                    <div class="mb-4">
                        <h6>4.2 Blood Sugar</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Fasting Blood Sugar</label>
                                    <input type="text" asp-for="Assessment.FastingBloodSugar" class="form-control" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Random Blood Sugar</label>
                                    <input type="text" asp-for="Assessment.RandomBloodSugar" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Status:</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BloodSugarStatus" value="Normal" />
                                    <label class="form-check-label">Normal (<100)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BloodSugarStatus" value="Impaired" />
                                    <label class="form-check-label">Impaired fasting glucose (100–125)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BloodSugarStatus" value="DM" />
                                    <label class="form-check-label">DM (>126 or RBS ≥200 + symptoms)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BloodSugarStatus" value="Pre-Diabetes" />
                                    <label class="form-check-label">Pre-Diabetes</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BloodSugarStatus" value="DM" />
                                    <label class="form-check-label">DM</label>
                                </div>
                            </div>
                        </div>
                        
                        <h6>Symptoms:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasPolyuria" value="true" />
                                    <label class="form-check-label">Polyuria</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasPolydipsia" value="true" />
                                    <label class="form-check-label">Polydipsia</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasPolyphagia" value="true" />
                                    <label class="form-check-label">Polyphagia</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasWeightLoss" value="true" />
                                    <label class="form-check-label">Weight loss</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.3 Blood Pressure</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Left arm mean BP</label>
                                    <input type="text" asp-for="Assessment.LeftArmMeanBP" class="form-control" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Right arm mean BP</label>
                                    <input type="text" asp-for="Assessment.RightArmMeanBP" class="form-control" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Baseline BP</label>
                                    <input type="text" asp-for="Assessment.BaselineBP" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Status:</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BPStatus" value="Normal" />
                                    <label class="form-check-label">Normal (<120/80)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BPStatus" value="Pre-HPN" />
                                    <label class="form-check-label">Pre-HPN (120–139/80–89)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BPStatus" value="Stage 1" />
                                    <label class="form-check-label">Stage 1 (140–159/90–99)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BPStatus" value="Stage 2" />
                                    <label class="form-check-label">Stage 2 (≥160/≥100)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BPStatus" value="Elevated" />
                                    <label class="form-check-label">Elevated BP</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.4 Cholesterol</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Result</label>
                                    <input type="text" asp-for="Assessment.CholesterolResult" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Status:</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="CholesterolStatus" value="Normal" />
                                    <label class="form-check-label">Normal (<200)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="CholesterolStatus" value="Elevated" />
                                    <label class="form-check-label">Elevated (200–239)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="CholesterolStatus" value="High" />
                                    <label class="form-check-label">High (≥240)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.5 Urine Dipstick Test</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Protein</label>
                                    <input type="text" asp-for="Assessment.UrineProtein" class="form-control" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Ketones</label>
                                    <input type="text" asp-for="Assessment.UrineKetones" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasUrineProtein" value="true" />
                                    <label class="form-check-label">(+) urine protein</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" />
                                    <label class="form-check-label">(–) urine protein</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasUrineKetones" value="true" />
                                    <label class="form-check-label">(+) urine ketones</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" />
                                    <label class="form-check-label">(–) urine ketones</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.6 Risk Profile (For Doctors Only)</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="RiskPercentage" value="<5%" />
                                    <label class="form-check-label"><5%</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="RiskPercentage" value="5–10%" />
                                    <label class="form-check-label">5–10%</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="RiskPercentage" value="10–<20%" />
                                    <label class="form-check-label">10–<20%</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="RiskPercentage" value="20–<30%" />
                                    <label class="form-check-label">20–<30%</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="RiskPercentage" value="≥30%" />
                                    <label class="form-check-label">≥30%</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.7 Cancer Screening (Babae ≥30 years old)</h6>
                        <p>Ikaw ba ay nai-screen na sa Breast/Cervical Cancer?</p>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Assessment.BreastCancerScreened" value="true" />
                            <label class="form-check-label">Oo (ipaalala ang next visit)</label>
