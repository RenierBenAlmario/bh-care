                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.NeverSmokedButExposedToSmoke" value="true" />
                                    <label class="form-check-label">Hindi, pero lantad sa usok ng sigarilyo</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasHistoryOfSmoking" value="true" />
                                    <label class="form-check-label">With history of smoking</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Istres (Stress):</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Assessment.HasStress" value="true" />
                                    <label class="form-check-label">Oo</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" />
                                    <label class="form-check-label">Hindi</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Step 5: Anthropometric Measurements -->
                <div class="wizard-step d-none" data-step="5">
                    <h4 class="mb-3">Part IV. Anthropometric Measurement</h4>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Weight</label>
                                <input type="text" asp-for="Assessment.Weight" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Height</label>
                                <input type="text" asp-for="Assessment.Height" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">BMI</label>
                                <input type="text" asp-for="Assessment.BMI" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Waist</label>
                                <input type="text" asp-for="Assessment.Waist" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Hip</label>
                                <input type="text" asp-for="Assessment.Hip" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">WH Ratio</label>
                                <input type="text" asp-for="Assessment.WHRatio" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Status:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>BMI Status:</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BMIStatus" value="Underweight" />
                                    <label class="form-check-label">Underweight (<18.5)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BMIStatus" value="Normal" />
                                    <label class="form-check-label">Normal (18.5–22.9)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BMIStatus" value="Overweight" />
                                    <label class="form-check-label">Overweight (23–24.9)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="BMIStatus" value="Obese" />
                                    <label class="form-check-label">Obese (≥25)</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>WH Status:</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="WHStatus" value="No risk" />
                                    <label class="form-check-label">No risk</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="WHStatus" value="At risk" />
