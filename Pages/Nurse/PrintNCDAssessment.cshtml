@page
@model Barangay.Pages.Nurse.PrintNCDAssessmentModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NCD Risk Assessment - Print</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.4;
            margin: 0;
            padding: 20px;
            color: #000;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #000;
            padding-bottom: 20px;
        }
        
        .header h1 {
            font-size: 18px;
            font-weight: bold;
            margin: 0 0 10px 0;
        }
        
        .header h2 {
            font-size: 14px;
            font-weight: bold;
            margin: 0;
        }
        
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        
        .section-title {
            font-size: 14px;
            font-weight: bold;
            background-color: #f0f0f0;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #000;
        }
        
        .form-row {
            display: flex;
            margin-bottom: 8px;
        }
        
        .form-group {
            flex: 1;
            margin-right: 15px;
        }
        
        .form-group:last-child {
            margin-right: 0;
        }
        
        .form-label {
            font-weight: bold;
            display: block;
            margin-bottom: 3px;
        }
        
        .form-value {
            border-bottom: 1px solid #000;
            padding: 2px 0;
            min-height: 18px;
        }
        
        .checkbox-group {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }
        
        .checkbox {
            width: 15px;
            height: 15px;
            border: 2px solid #000;
            margin-right: 8px;
            display: inline-block;
            position: relative;
            vertical-align: middle;
            text-align: center;
            line-height: 11px;
        }
        
        .checkbox.checked {
            background-color: #000;
            color: #fff;
        }
        
        .checkbox.checked::after {
            content: "✓";
            font-weight: bold;
            font-size: 12px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        
        .checkbox-label {
            font-weight: normal;
        }
        
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        
        .table th,
        .table td {
            border: 1px solid #000;
            padding: 5px;
            text-align: left;
        }
        
        .table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        
        .footer {
            margin-top: 40px;
            border-top: 1px solid #000;
            padding-top: 20px;
        }
        
        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        
        .signature-box {
            width: 200px;
            text-align: center;
        }
        
        .signature-line {
            border-bottom: 1px solid #000;
            height: 40px;
            margin-bottom: 5px;
        }
        
        @@media print {
            body {
                margin: 0;
                padding: 15px;
            }
            
            .no-print {
                display: none !important;
            }
            
            .page-break {
                page-break-before: always;
            }
            
            .checkbox {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .checkbox.checked {
                background-color: #000 !important;
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .checkbox.checked::after {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>REPUBLIC OF THE PHILIPPINES</h1>
        <h2>NON-COMMUNICABLE DISEASE RISK ASSESSMENT FORM</h2>
        <p><strong>Assessment Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        
        <!-- Update Button -->
        <div class="no-print" style="margin-top: 20px; text-align: center;">
            <a href="/Nurse/EditNCDAssessment?appointmentId=@Model.NCDRiskAssessment.AppointmentId" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i>
                Update Assessment
            </a>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART I: DEMOGRAPHIC-SOCIO-ECONOMIC PROFILE</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Health Facility:</span>
                <div class="form-value">@Model.NCDRiskAssessment.HealthFacility</div>
            </div>
            <div class="form-group">
                <span class="form-label">Family No:</span>
                <div class="form-value">@Model.NCDRiskAssessment.FamilyNo</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Name:</span>
                <div class="form-value">@Model.NCDRiskAssessment.FirstName @Model.NCDRiskAssessment.MiddleName @Model.NCDRiskAssessment.LastName</div>
            </div>
            <div class="form-group">
                <span class="form-label">Age:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Edad years</div>
            </div>
            <div class="form-group">
                <span class="form-label">Gender:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Kasarian</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Civil Status:</span>
                <div class="form-value">@Model.NCDRiskAssessment.CivilStatus</div>
            </div>
            <div class="form-group">
                <span class="form-label">Occupation:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Occupation</div>
            </div>
            <div class="form-group">
                <span class="form-label">Religion:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Relihiyon</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Address:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Address</div>
            </div>
            <div class="form-group">
                <span class="form-label">Barangay:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Barangay</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Contact Number:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Telepono</div>
            </div>
            <div class="form-group">
                <span class="form-label">Birthday:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Birthday</div>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART II: PAST MEDICAL HISTORY</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Mayroon ba ay may sumusunod nakaraang karamdaman?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasDiabetes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Diabetes</span>
                @if (Model.NCDRiskAssessment.HasDiabetes == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.DiabetesYear, Medication: @Model.NCDRiskAssessment.DiabetesMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasHypertension == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hypertension</span>
                @if (Model.NCDRiskAssessment.HasHypertension == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.HypertensionYear, Medication: @Model.NCDRiskAssessment.HypertensionMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasCancer == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Cancer</span>
                @if (Model.NCDRiskAssessment.HasCancer == "true")
                {
                    <span> - Type: @Model.NCDRiskAssessment.CancerType, Year: @Model.NCDRiskAssessment.CancerYear, Medication: @Model.NCDRiskAssessment.CancerMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasLungDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Sakit sa baga na hindi nakakahawa</span>
                @if (Model.NCDRiskAssessment.HasLungDisease == "true")
                {
                    <span> - Year: @Model.NCDRiskAssessment.LungDiseaseYear, Medication: @Model.NCDRiskAssessment.LungDiseaseMedication</span>
                }
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Pananaklit ng dibdib (Chest pain)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasChestPain == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Pananakit/kabigatan sa dibdib</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.ChestPainSpreadsToArm == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">May kumakalat na sakit hanggang braso</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.NumbnessWhenWalkingFast == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Pamamanhid kapag nagmamadali/naglalakad ng mabilis</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.PainRelievedWithRest == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Nawawala ang sakit kapag nakapahinga</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.LossOfConsciousnessLessThan10Min == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Nawawalan ng malay <10 minuto</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.PainLastsMoreThan30Min == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Sakit tumatagal >30 minuto</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.SeeDoctorIfYes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Kung Oo, magpatingin agad sa doktor</span>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.NCDRiskAssessment.DoctorName))
        {
            <div class="form-row">
                <div class="form-group">
                    <span class="form-label">Doktor:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.DoctorName</div>
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="section-title">PART III: ASSESSMENT OF RISK FACTORS</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">A. Non-Modifiable Risk Factors</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Sakit sa pamilya (Family history):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasHypertension == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hypertension</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasDiabetes == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Diabetes</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasStroke == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Stroke</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasCancer == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Cancer</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasKidneyDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Sakit sa bato</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FamilyHasOtherDisease == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Other Disease</span>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.NCDRiskAssessment.FamilyOtherDiseaseDetails))
        {
            <div class="form-row">
                <div class="form-group">
                    <span class="form-label">Other disease details:</span>
                    <div class="form-value">@Model.NCDRiskAssessment.FamilyOtherDiseaseDetails</div>
                </div>
            </div>
        }
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">B. Modifiable Risk Factors</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Nutrisyon (Nutrition):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Madalas mo bang kainin kada araw?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsVegetablesDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Gulay</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFruitsDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Prutas</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFishDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Isda</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsMeatDaily == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Karne</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUnhealthyDiet == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Unhealthy Diet</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Kumakain ka ba ng higit sa 2 beses kada linggo ng:</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsFattyFoodMoreThan2TimesPerWeek == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Matatabang pagkain</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsSweetFoodMoreThan2TimesPerWeek == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Matatamis na pagkain</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.EatsOilyFoodMoreThan2TimesPerWeek == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Mamantikang pagkain</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasHighSaltIntake == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">With high salt intake</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Alakhol (Alcohol):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.DrinksAlcohol == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Umiinom ka ba ng alak? Oo</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Ehersisyo (Physical Activity):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.ModerateIntensityExercise == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Moderate Intensity</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.VigorousIntensityExercise == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Vigorous Intensity</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.CombinationExercise == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Kombinasyon</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.InsufficientPhysicalActivity == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Insufficient Physical Activity</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Paninigarilyo (Smoking):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.FormerSmoker == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Oo, pero tumigil na</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.NeverSmokedButExposedToSmoke == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hindi, pero lantad sa usok ng sigarilyo</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasHistoryOfSmoking == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">With history of smoking</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Istres (Stress):</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasStress == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Oo</span>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART IV: ANTHROPOMETRIC MEASUREMENT</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Weight:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Weight</div>
            </div>
            <div class="form-group">
                <span class="form-label">Height:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Height</div>
            </div>
            <div class="form-group">
                <span class="form-label">BMI:</span>
                <div class="form-value">@Model.NCDRiskAssessment.BMI</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Waist:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Waist</div>
            </div>
            <div class="form-group">
                <span class="form-label">Hip:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Hip</div>
            </div>
            <div class="form-group">
                <span class="form-label">WH Ratio:</span>
                <div class="form-value">@Model.NCDRiskAssessment.WHRatio</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.2 Blood Sugar</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Fasting Blood Sugar:</span>
                <div class="form-value">@Model.NCDRiskAssessment.FastingBloodSugar</div>
            </div>
            <div class="form-group">
                <span class="form-label">Random Blood Sugar:</span>
                <div class="form-value">@Model.NCDRiskAssessment.RandomBloodSugar</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Symptoms:</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolyuria == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polyuria</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolydipsia == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polydipsia</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasPolyphagia == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Polyphagia</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasWeightLoss == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Weight loss</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.3 Blood Pressure</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Left arm mean BP:</span>
                <div class="form-value">@Model.NCDRiskAssessment.LeftArmMeanBP</div>
            </div>
            <div class="form-group">
                <span class="form-label">Right arm mean BP:</span>
                <div class="form-value">@Model.NCDRiskAssessment.RightArmMeanBP</div>
            </div>
            <div class="form-group">
                <span class="form-label">Baseline BP:</span>
                <div class="form-value">@Model.NCDRiskAssessment.BaselineBP</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.4 Cholesterol</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Result:</span>
                <div class="form-value">@Model.NCDRiskAssessment.CholesterolResult</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.5 Urine Dipstick Test</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Protein:</span>
                <div class="form-value">@Model.NCDRiskAssessment.UrineProtein</div>
            </div>
            <div class="form-group">
                <span class="form-label">Ketones:</span>
                <div class="form-value">@Model.NCDRiskAssessment.UrineKetones</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineProtein == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(+) urine protein</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.HasUrineKetones == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">(+) urine ketones</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.6 Risk Profile (For Doctors Only)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">4.7 Cancer Screening (Babae ≥30 years old)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Ikaw ba ay nai-screen na sa Breast/Cervical Cancer?</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.BreastCancerScreened == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Oo (ipaalala ang next visit)</span>
            </div>
        </div>
        
        <div class="form-row">
            <div class="checkbox-group">
                <span class="checkbox @(Model.NCDRiskAssessment.CervicalCancerScreened == "true" ? "checked" : "")"></span>
                <span class="checkbox-label">Hindi (i-refer)</span>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">PART V: ASSESSMENT INFORMATION</div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Interviewed/Assessed by:</span>
                <div class="form-value">@Model.NCDRiskAssessment.InterviewedBy</div>
            </div>
            <div class="form-group">
                <span class="form-label">Designation:</span>
                <div class="form-value">@Model.NCDRiskAssessment.Designation</div>
            </div>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <span class="form-label">Date:</span>
                <div class="form-value">@Model.NCDRiskAssessment.AssessmentDate</div>
            </div>
        </div>
    </div>

    <div class="footer">
        <div class="signature-section">
            <div class="signature-box">
                <div class="signature-line"></div>
                <div>Patient Signature</div>
            </div>
            <div class="signature-box">
                <div class="signature-line"></div>
                <div>Interviewer/Assessor Signature</div>
            </div>
        </div>
        
        <div style="margin-top: 20px; text-align: center;">
            <p><strong>Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>

    <script>
        // Auto-print when page loads
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>
