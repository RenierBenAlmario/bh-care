@page "{appointmentId:int?}"
@model Barangay.Pages.Nurse.EditNCDAssessmentModel
@{
    ViewData["Title"] = "Edit NCD Risk Assessment";
    Layout = "_NurseLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Edit NCD Risk Assessment</h2>
        <div>
            <a href="/Nurse/PrintNCDAssessment?appointmentId=@Model.NCDRiskAssessment.AppointmentId" class="btn btn-success me-2" target="_blank">
                <i class="fas fa-print me-1"></i>
                Print Form
            </a>
            <a href="/Nurse/AppointmentDetails?id=@Model.NCDRiskAssessment.AppointmentId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Appointment
            </a>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
    {
        <div class="alert @(TempData["StatusMessage"].ToString().Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Patient: @Model.PatientName</h5>
        </div>
        <div class="card-body">
            <form method="post" id="ncdForm">
                <div class="mb-3">
                    <div class="progress" style="height: 8px;">
                        <div id="wizardProgress" class="progress-bar bg-primary" role="progressbar" style="width: 20%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mt-1">
                        <span>1. Demographics</span>
                        <span>2. Medical</span>
                        <span>3. Family</span>
                        <span>4. Risk</span>
                        <span>5. Measurements</span>
                        <span>6. Assessment</span>
                    </div>
                </div>
                <input type="hidden" asp-for="NCDRiskAssessment.AppointmentId" />
                <input type="hidden" asp-for="NCDRiskAssessment.Id" />
                <input type="hidden" asp-for="NCDRiskAssessment.UserId" />
                <!-- Removed hidden birthday to show as visible field below -->
                <input type="hidden" asp-for="NCDRiskAssessment.Edad" />
                
                <!-- Step 1: Demographics -->
                <div class="wizard-step" data-step="1">
                    <h4 class="mb-3">Part I. Demographic-Socio-Economic Profile</h4>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Health Facility</label>
                                <input type="text" asp-for="NCDRiskAssessment.HealthFacility" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Family Number</label>
                                <input type="text" asp-for="NCDRiskAssessment.FamilyNo" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">ID Number</label>
                                <input type="text" asp-for="NCDRiskAssessment.IDNumber" class="form-control" />
                            </div>
                            
                            <!-- ADD: Additional ID Field -->
                            <div class="form-group mb-3">
                                <label class="form-label">ID No.</label>
                                <input type="text" asp-for="NCDRiskAssessment.IDNo" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">First Name</label>
                                <input type="text" asp-for="NCDRiskAssessment.FirstName" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Middle Name</label>
                                <input type="text" asp-for="NCDRiskAssessment.MiddleName" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Last Name</label>
                                <input type="text" asp-for="NCDRiskAssessment.LastName" class="form-control" />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Date of Assessment</label>
                                <input type="date" asp-for="NCDRiskAssessment.DateOfAssessment" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Birthday (mm/dd/yy)</label>
                                <input type="date" asp-for="NCDRiskAssessment.Birthday" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Address</label>
                                <input type="text" asp-for="NCDRiskAssessment.Address" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Barangay</label>
                                <input type="text" asp-for="NCDRiskAssessment.Barangay" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Telepono</label>
                                <input type="text" asp-for="NCDRiskAssessment.Telepono" class="form-control" />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Age</label>
                                <input type="text" asp-for="NCDRiskAssessment.Edad" class="form-control" readonly />
                            </div>
                            
                            <div class="form-group mb-3">
                                <label class="form-label">Gender</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.Kasarian" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.Kasarian" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Religion</label>
                                <input type="text" asp-for="NCDRiskAssessment.Relihiyon" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Occupation</label>
                                <input type="text" asp-for="NCDRiskAssessment.Occupation" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">Civil Status</label>
                                <input type="text" asp-for="NCDRiskAssessment.CivilStatus" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Risk Status</label>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasDiabetes" />
                                    <label class="form-check-label">DM</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasHypertension" />
                                    <label class="form-check-label">HPN</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasCancer" />
                                    <label class="form-check-label">Cancer (specify site)</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasCOPD" />
                                    <label class="form-check-label">COPD</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                
                <!-- Step 2: Medical History -->
                <div class="wizard-step d-none" data-step="2">
                    <h4 class="mb-3">Part II. Past Medical History</h4>
                    <div class="mb-4">
                        <h6>Mayroon ba ay may sumusunod nakaraang karamdaman?</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasDiabetes" />
                                    <label class="form-check-label">Diabetes</label>
                                </div>
                                <div id="diabetesFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.DiabetesYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.DiabetesMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasHypertension" />
                                    <label class="form-check-label">Hypertension</label>
                                </div>
                                <div id="hypertensionFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.HypertensionYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.HypertensionMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasCancer" id="hasCancer" />
                                    <label class="form-check-label">Cancer</label>
                                </div>
                                <div id="cancerTypeDiv" class="mb-2 d-none">
                                    <input type="text" asp-for="NCDRiskAssessment.CancerType" class="form-control form-control-sm" placeholder="Cancer type" />
                                    <div class="mt-2"></div>
                                    <input type="text" asp-for="NCDRiskAssessment.CancerYear" class="form-control form-control-sm mt-2" placeholder="Year Diagnosed" />
                                    <input type="text" asp-for="NCDRiskAssessment.CancerMedication" class="form-control form-control-sm mt-2" placeholder="Medication" />
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasLungDisease" />
                                    <label class="form-check-label">Sakit sa baga na hindi nakakahawa</label>
                                </div>
                                <div id="lungDiseaseFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.LungDiseaseYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.LungDiseaseMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasEyeDisease" />
                                    <label class="form-check-label">Sakit sa mata</label>
                                </div>
                                <div id="eyeDiseaseFields" class="row g-2 ms-4 d-none">
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.EyeDiseaseYear" class="form-control form-control-sm" placeholder="Year Diagnosed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" asp-for="NCDRiskAssessment.EyeDiseaseMedication" class="form-control form-control-sm" placeholder="Medication" />
                                    </div>
                                </div>
                                
                                <!-- ADD: Additional Medical Details -->
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasAsthma" />
                                    <label class="form-check-label">Asthma</label>
                                </div>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasDifficultyBreathing" />
                                    <label class="form-check-label">Has Difficulty Breathing</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>Pananaklit ng dibdib (Chest pain)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.HasChestPain" />
                            <label class="form-check-label">Pananakit/kabigatan sa dibdib</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.ChestPainSpreadsToArm" />
                            <label class="form-check-label">May kumakalat na sakit hanggang braso</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.NumbnessWhenWalkingFast" />
                            <label class="form-check-label">Pamamanhid kapag nagmamadali/naglalakad ng mabilis</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.PainRelievedWithRest" />
                            <label class="form-check-label">Nawawala ang sakit kapag nakapahinga</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.LossOfConsciousnessLessThan10Min" />
                            <label class="form-check-label">Nawawalan ng malay <10 minuto</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.PainLastsMoreThan30Min" />
                            <label class="form-check-label">Sakit tumatagal >30 minuto</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.SeeDoctorIfYes" />
                            <label class="form-check-label">Kung Oo, magpatingin agad sa doktor</label>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Doktor</label>
                            <input type="text" asp-for="NCDRiskAssessment.DoctorName" class="form-control" />
                        </div>
                    </div>
                </div>
                
                <!-- Step 3: Family History -->
                <div class="wizard-step d-none" data-step="3">
                    <h4 class="mb-3">Part III. Assessment of Risk Factors</h4>
                    <h5 class="mb-3">A. Non-Modifiable Risk Factors</h5>
                    <div class="mb-4">
                        <h6>Sakit sa pamilya (Family history):</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Sakit</th>
                                    <th>Ama</th>
                                    <th>Ina</th>
                                    <th>Kapatid</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Mataas na presyon</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHypertensionFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHypertensionMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHypertensionSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Stroke</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Diabetes</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Kanser</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Sakit sa baga na hindi nakakahawa</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Sakit sa bato</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseSibling" class="form-check-input" /></td>
                                </tr>
                                <tr>
                                    <td>Sakit sa mata</td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseFather" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseMother" class="form-check-input" /></td>
                                    <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseSibling" class="form-check-input" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="form-group mb-3">
                            <label class="form-label">Isulat: (Other disease details)</label>
                            <input type="text" asp-for="NCDRiskAssessment.FamilyOtherDiseaseDetails" class="form-control" />
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" />
                            <label class="form-check-label">First degree relatives</label>
                        </div>
                        
                        <!-- ADD: Individual Family History Details -->
                        <div class="mb-3">
                            <h6>Individual Family History:</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Condition</th>
                                        <th>Father</th>
                                        <th>Mother</th>
                                        <th>Sibling</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Cancer</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryCancerSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Diabetes</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryDiabetesSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Heart Disease</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHeartDiseaseFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHeartDiseaseMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryHeartDiseaseSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Lung Disease</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryLungDiseaseSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Stroke</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryStrokeSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Kidney Disease</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryKidneyDiseaseSibling" class="form-check-input" /></td>
                                    </tr>
                                    <tr>
                                        <td>Eye Disease</td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseFather" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseMother" class="form-check-input" /></td>
                                        <td><input type="checkbox" asp-for="NCDRiskAssessment.FamilyHistoryEyeDiseaseSibling" class="form-check-input" /></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <!-- Step 4: Modifiable Risk Factors -->
                <div class="wizard-step d-none" data-step="4">
                    <h5 class="mb-3">B. Modifiable Risk Factors</h5>
                    
                    <div class="mb-4">
                        <h6>Nutrisyon (Nutrition):</h6>
                        <p>Madalas mo bang kainin kada araw?</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.EatsVegetablesDaily" />
                                    <label class="form-check-label">Gulay</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.EatsFruitsDaily" />
                                    <label class="form-check-label">Prutas</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.EatsFishDaily" />
                                    <label class="form-check-label">Isda</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.EatsMeatDaily" />
                                    <label class="form-check-label">Karne</label>
                                </div>
                                <div class="form-check mb-2">
