                                    <label class="form-check-label">20–<30%</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="NCDRiskAssessment.RiskPercentage" value="≥30%" />
                                    <label class="form-check-label">≥30%</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6>4.7 Cancer Screening (Babae ≥30 years old)</h6>
                        <p>Ikaw ba ay nai-screen na sa Breast/Cervical Cancer?</p>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.BreastCancerScreened" />
                            <label class="form-check-label">Oo (ipaalala ang next visit)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="NCDRiskAssessment.CervicalCancerScreened" />
                            <label class="form-check-label">Hindi (i-refer)</label>
                        </div>
                    </div>
                </div>
                
                <!-- Step 6: Assessment Information -->
                <div class="wizard-step d-none" data-step="6">
                    <h4 class="mb-3">Assessment Information</h4>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Interviewed/Assessed by:</label>
                                <input type="text" asp-for="NCDRiskAssessment.InterviewedBy" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Name:</label>
                                <input type="text" asp-for="NCDRiskAssessment.InterviewedBy" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Designation:</label>
                                <input type="text" asp-for="NCDRiskAssessment.Designation" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Date:</label>
                                <input type="date" asp-for="NCDRiskAssessment.AssessmentDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Signature of Patient</label>
                                <input type="text" asp-for="NCDRiskAssessment.PatientSignature" class="form-control" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Name:</label>
                                <input type="text" asp-for="NCDRiskAssessment.FirstName" class="form-control" readonly />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Signature:</label>
                                <input type="text" asp-for="NCDRiskAssessment.PatientSignature" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Navigation Buttons -->
                <div class="d-flex justify-content-between mt-3">
                    <button type="button" class="btn btn-outline-secondary" id="btnPrev" disabled>Previous</button>
                    <div>
                        <button type="button" class="btn btn-primary" id="btnNext">Next</button>
                        <button type="submit" class="btn btn-success d-none" id="btnSubmit">Save Changes</button>
                    </div>
                </div>
                <div class="mt-4">
                    <a href="/Nurse/AppointmentDetails?id=@Model.NCDRiskAssessment.AppointmentId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toggle cancer type input visibility
            $('#hasCancer').change(function() {
                if($(this).is(':checked')) {
                    $('#cancerTypeDiv').removeClass('d-none');
                } else {
                    $('#cancerTypeDiv').addClass('d-none');
                    $('#NCDRiskAssessment_CancerType').val('');
                }
            });
            
            function toggleSection(selector, target) {
                const isChecked = $(selector).is(':checked');
                if (isChecked) {
                    $(target).removeClass('d-none');
                } else {
                    $(target).addClass('d-none');
                    $(target).find('input').val('');
                }
            }
            
            // Initialize visibility based on current values
            toggleSection('#NCDRiskAssessment_HasDiabetes', '#diabetesFields');
            toggleSection('#NCDRiskAssessment_HasHypertension', '#hypertensionFields');
            toggleSection('#NCDRiskAssessment_HasLungDisease', '#lungDiseaseFields');
            toggleSection('#NCDRiskAssessment_HasEyeDisease', '#eyeDiseaseFields');
            toggleSection('#hasCancer', '#cancerTypeDiv');
            
            // Bind change events
            $('#NCDRiskAssessment_HasDiabetes').on('change', function(){ toggleSection('#NCDRiskAssessment_HasDiabetes', '#diabetesFields'); });
            $('#NCDRiskAssessment_HasHypertension').on('change', function(){ toggleSection('#NCDRiskAssessment_HasHypertension', '#hypertensionFields'); });
            $('#NCDRiskAssessment_HasLungDisease').on('change', function(){ toggleSection('#NCDRiskAssessment_HasLungDisease', '#lungDiseaseFields'); });
            $('#NCDRiskAssessment_HasEyeDisease').on('change', function(){ toggleSection('#NCDRiskAssessment_HasEyeDisease', '#eyeDiseaseFields'); });
            $('#hasCancer').on('change', function(){ toggleSection('#hasCancer', '#cancerTypeDiv'); });
            
            var currentStep = 1;
            var totalSteps = 6;
            
            function showStep(n) {
                $('.wizard-step').addClass('d-none');
                $('.wizard-step[data-step="' + n + '"]').removeClass('d-none');
                $('#btnPrev').prop('disabled', n === 1);
                $('#btnNext').toggle(n < totalSteps);
                $('#btnSubmit').toggleClass('d-none', n < totalSteps);
                var pct = Math.round((n/totalSteps)*100);
                $('#wizardProgress').css('width', pct + '%');
            }
            
            $('#btnPrev').on('click', function(e){ 
                e.preventDefault(); 
                if(currentStep > 1){ 
                    currentStep--; 
                    showStep(currentStep); 
                }
            });
            
            $('#btnNext').on('click', function(e){ 
                e.preventDefault(); 
                if(currentStep < totalSteps){ 
                    currentStep++; 
                    showStep(currentStep); 
                }
            });
            
            showStep(1);
            
            // Form validation
            $('#ncdForm').on('submit', function(e) {
                var isValid = true;
                var errorMessage = '';

                // Check required fields
                $('input[required], select[required], textarea[required]').each(function() {
                    if (!$(this).val()) {
                        isValid = false;
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });
        });
    </script>
}


