@page
@model Barangay.Pages.Nurse.EditHEEADSSSAssessmentModel
@{
    ViewData["Title"] = "Edit HEEADSSS Assessment";
    var isDoctor = User.IsInRole("Doctor") || User.IsInRole("Head Doctor") || User.IsInRole("Admin");
    Layout = isDoctor ? "_DoctorLayout" : "~/Pages/Shared/_NurseLayout.cshtml";
}

@section Styles {
    <style>
        /* Scoped variables for this page */
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --background-color: #f8f9fa;
            --form-bg-color: #ffffff;
            --text-color: #333;
            --border-color: #dee2e6;
            --danger-color: #dc3545;
        }

        /* Page-scoped container styles */
        .heeadsss-container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--form-bg-color);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }

        .heeadsss-container h1,
        .heeadsss-container h2,
        .heeadsss-container h3 {
            color: var(--primary-color);
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .heeadsss-container .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            background: #fff;
        }
        
        .form-label.required::after {
            content: " *";
            color: red;
        }
        
        .age-indicator {
            background: #007bff;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: bold;
        }
    </style>
}

<div class="container heeadsss-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">
            <i class="fas fa-edit text-primary me-2"></i>
            Edit HEEADSSS Assessment
        </h1>
        @if (isDoctor)
        {
            <a href="/Doctor/Consultation?id=@Model.Assessment.AppointmentId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Consultation
            </a>
        }
        else
        {
            <a href="/Nurse/AppointmentDetails?id=@Model.Assessment.AppointmentId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Appointment
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
    {
        <div class="alert @(TempData["StatusMessage"].ToString().Contains("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" id="heeadsssAssessmentForm">
        @Html.AntiForgeryToken()
        <input asp-for="Assessment.AppointmentId" type="hidden" />
        <input asp-for="Assessment.UserId" type="hidden" />

        <!-- Header Section -->
        <div class="form-section">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Date of Registration:</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Client No.:</label>
                        <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="family-no" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Referred by:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReferredBy" />
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Options:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsNHPTS" onchange="updateCheckboxValue('IsNHPTS', 'Assessment.IsNHPTS')" />
                    <input type="hidden" asp-for="Assessment.IsNHPTS" />
                    <label class="form-check-label" for="IsNHPTS">NHPTS</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsPhilHealthBeneficiaryOnly" onchange="updateCheckboxValue('IsPhilHealthBeneficiaryOnly', 'Assessment.IsPhilHealthBeneficiaryOnly')" />
                    <input type="hidden" asp-for="Assessment.IsPhilHealthBeneficiaryOnly" />
                    <label class="form-check-label" for="IsPhilHealthBeneficiaryOnly">PhilHealth Beneficiary Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="IsOwnPhilHealth" onchange="updateCheckboxValue('IsOwnPhilHealth', 'Assessment.IsOwnPhilHealth')" />
                    <input type="hidden" asp-for="Assessment.IsOwnPhilHealth" />
                    <label class="form-check-label" for="IsOwnPhilHealth">Own PhilHealth / PIN:</label>
                    <input type="text" class="form-control d-inline-block ms-2" style="width: 200px;" asp-for="Assessment.PhilHealthPIN" />
                </div>
            </div>
        </div>

        <!-- Confidentiality Notice -->
        <div class="form-section">
            <h3>Palaala</h3>
            <div class="alert alert-info">
                <p><strong>Pamantayan ng klinika na ito na panatilihing CONFIDENTIAL o SIKRETO ang mga impormasyong personal.</strong> Ang iyong sagot ay hindi ibabahagi kaninuman, maliban kung kinakailangan upang matulungan ka sa mga sitwasyong tulad ng:</p>
                <ul>
                    <li>Ang kabataan ay may planong saktan ang sarili o iba.</li>
                    <li>Biktima ng pang-aabuso.</li>
                    <li>Sangkot sa krimen o iba pang aktibidad na may kaugnayan sa batas.</li>
                </ul>
            </div>
        </div>

        <!-- Profile Section -->
        <div class="form-section">
            <h3>1. Profile</h3>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Health Facility</label>
                        <input type="text" class="form-control" value="Baesa Health Center" readonly />
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label">Date of Assessment</label>
                        <input type="text" class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" readonly />
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label required">Birthday</label>
                        <input type="date" class="form-control" asp-for="Assessment.Birthday" />
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Patient Name</label>
                        <input type="text" class="form-control" asp-for="Assessment.FullName" />
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label">Family No.</label>
                        <div class="d-flex">
                            <input type="text" class="form-control" asp-for="Assessment.FamilyNo" id="family-no" />
                            <button type="button" id="generate-family-no" class="btn btn-secondary ms-2">Generate</button>
                        </div>
                        <small class="form-text text-muted">If you have a family number, enter it or click Generate to create a new one.</small>
                    </div>
                
                    <div class="mb-3">
                        <label class="form-label">Contact Number</label>
                        <input type="text" class="form-control" asp-for="Assessment.ContactNumber" />
                        <small class="form-text text-muted">11 digits only, Philippine format (e.g. 09123456789)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- B. Adolescent Health Information Section -->
        <div class="form-section">
            <h3>B. ADOLESCENT HEALTH INFORMATION</h3>
            
            <!-- Measurements -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Height (cm)</label>
                        <input type="text" class="form-control" asp-for="Assessment.Height" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Weight (kg)</label>
                        <input type="text" class="form-control" asp-for="Assessment.Weight" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">BMI (kg/m²)</label>
                        <input type="text" class="form-control" asp-for="Assessment.BMI" readonly />
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">BMI Status:</label>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="BMIUnderweight" onchange="updateCheckboxValue('BMIUnderweight', 'Assessment.BMIUnderweight')" />
                            <input type="hidden" asp-for="Assessment.BMIUnderweight" />
                            <label class="form-check-label" for="BMIUnderweight">Underweight</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="BMINormal" onchange="updateCheckboxValue('BMINormal', 'Assessment.BMINormal')" />
                            <input type="hidden" asp-for="Assessment.BMINormal" />
                            <label class="form-check-label" for="BMINormal">Normal</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="BMIOverweight" onchange="updateCheckboxValue('BMIOverweight', 'Assessment.BMIOverweight')" />
                            <input type="hidden" asp-for="Assessment.BMIOverweight" />
                            <label class="form-check-label" for="BMIOverweight">Overweight</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="BMIObese" onchange="updateCheckboxValue('BMIObese', 'Assessment.BMIObese')" />
                            <input type="hidden" asp-for="Assessment.BMIObese" />
                            <label class="form-check-label" for="BMIObese">Obese</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Immunization Status + For Females Only (top-right) -->
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-8">
                        <label class="form-label">Immunization Status:</label>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">MR/MMR date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationMR" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Td date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationTd" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">HPV date given:</label>
                                    <input type="date" class="form-control" asp-for="Assessment.ImmunizationHPV" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="female-only-section" style="display: none;">
                            <label class="form-label">For Females Only: (if applicable)</label>
                            <div class="mb-2">
                                <label class="form-label">Date of Menarche:</label>
                                <input type="date" class="form-control" asp-for="Assessment.DateOfMenarche" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Age of 1st Pregnancy:</label>
                                <input type="text" class="form-control" asp-for="Assessment.AgeOfFirstPregnancy" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">OB Score:</label>
                                <input type="text" class="form-control" asp-for="Assessment.OBScore" placeholder="G__ P__ (__ __ __ __)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vital Signs and Medical Information -->
        <div class="form-section">
            <div class="row">
                <div class="col-md-6">
                    <!-- Vital Signs -->
                    <h4>Vital Signs</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered" style="width: 100%;">
                            <tr>
                                <td style="width: 50%;"><strong>Temp</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalTemp" /></td>
                            </tr>
                            <tr>
                                <td><strong>RR</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalRR" /></td>
                            </tr>
                            <tr>
                                <td><strong>PR/CR</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalPR" /></td>
                            </tr>
                            <tr>
                                <td><strong>BP</strong></td>
                                <td><input type="text" class="form-control form-control-sm" asp-for="Assessment.VitalBP" /></td>
                            </tr>
                        </table>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Chief Complaint:
                        <textarea class="form-control" asp-for="Assessment.ChiefComplaint" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="label">History of Present Illness:</label>
                        <textarea class="form-control" asp-for="Assessment.HistoryOfPresentIllness" rows="3"></textarea>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Pertinent Physical Examination Findings:</label>
                        <textarea class="form-control" asp-for="Assessment.PhysicalExaminationFindings" rows="13"></textarea>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Past Medical History:</label>
                        <textarea class="form-control" asp-for="Assessment.PastMedicalHistory" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Working Diagnosis:</label>
                        <textarea class="form-control" asp-for="Assessment.WorkingDiagnosis" rows="3"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Management:</label>
                        <textarea class="form-control" asp-for="Assessment.Management" rows="3"></textarea>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Family History:</label>
                        <textarea class="form-control" asp-for="Assessment.FamilyHistory" rows="9"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Referral Information -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Referred to:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReferredTo" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Reason for Referral:</label>
                        <input type="text" class="form-control" asp-for="Assessment.ReasonForReferral" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Follow-up Date:</label>
                        <input type="date" class="form-control" asp-for="Assessment.FollowUpDate" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Psychosocial History Header -->
        <div class="form-section">
            <h3>C. Psychosocial History and Assessment</h3>
            <p><em>Ang matatapat mong kasagutan ay makakatulong upang makapagbigay ng tamang pangangalaga.</em></p>
        </div>

        <!-- HOME Section -->
        <div class="form-section">
            <h3>HOME</h3>
            
            <div class="mb-3">
                <label class="form-label">Meron bang problema sa inyong pamilya na maaring makaapekto sa iyo?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyProblems" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Pinakikitaan ka ba ng iyong mga magulang o guardian sa tuwing may problema ka?</label>
                <textarea class="form-control" asp-for="Assessment.HomeParentalListening" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May pagkakataon bang naisip mong maglayas?</label>
                <textarea class="form-control" asp-for="Assessment.HomeRunawayThoughts" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Sa nakaraang taon, may pagbabago ba sa loob ng iyong pamilya?</label>
                <textarea class="form-control" asp-for="Assessment.HomeFamilyChanges" rows="3"></textarea>
            </div>
        </div>

        <!-- EDUCATION Section -->
        <div class="form-section">
            <h3>EDUCATION</h3>
            
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay kasalukuyang nag-aaral?</label>
                <textarea class="form-control" asp-for="Assessment.EducationCurrentlyStudying" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nagtatrabaho? Kung oo, anong trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationWorking" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May problema ka ba sa iskuwela o trabaho?</label>
                <textarea class="form-control" asp-for="Assessment.EducationSchoolWorkProblems" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Nakaranas ka bang ma-api (bully) sa iskuwela o ibang pagkakataon?</label>
                <textarea class="form-control" asp-for="Assessment.EducationBullyingExperience" rows="3"></textarea>
            </div>
        </div>

        <!-- EATING HABITS Section -->
        <div class="form-section">
            <h3>EATING HABITS</h3>
                
            <div class="mb-3">
                <label class="form-label">Kuntento ka ba sa iyong itsura, anyo, o kasalukuyang timbang?</label>
                <textarea class="form-control" asp-for="Assessment.EatingBodyImageSatisfaction" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Sinubukan mo na bang magbawas ng timbang sa pamamagitan ng:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingVomiting" onchange="updateCheckboxValue('EatingVomiting', 'Assessment.EatingVomiting')" />
                    <input type="hidden" asp-for="Assessment.EatingVomiting" />
                    <label class="form-check-label" for="EatingVomiting">Pagduwal/pagsuka (vomiting)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingDietPills" onchange="updateCheckboxValue('EatingDietPills', 'Assessment.EatingDietPills')" />
                    <input type="hidden" asp-for="Assessment.EatingDietPills" />
                    <label class="form-check-label" for="EatingDietPills">Pag-inom ng diet pills</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingLaxatives" onchange="updateCheckboxValue('EatingLaxatives', 'Assessment.EatingLaxatives')" />
                    <input type="hidden" asp-for="Assessment.EatingLaxatives" />
                    <label class="form-check-label" for="EatingLaxatives">Laxatives</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EatingStarvation" onchange="updateCheckboxValue('EatingStarvation', 'Assessment.EatingStarvation')" />
                    <input type="hidden" asp-for="Assessment.EatingStarvation" />
                    <label class="form-check-label" for="EatingStarvation">Hindi pagkain (starvation)</label>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May nagpuna na ba na ikaw ay tumaba o pumayat?</label>
                <textarea class="form-control" asp-for="Assessment.EatingWeightComments" rows="3"></textarea>
            </div>
        </div>

        <!-- ACTIVITIES Section -->
        <div class="form-section">
            <h3>ACTIVITIES</h3>
                
            <div class="mb-3">
                <label class="form-label">Mayroon ka bang sinasalihang sports/libangan sa iskuwela, trabaho o bahay?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesParticipation" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Madalas ka bang nag-e-ehersisyo?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesRegularExercise" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Madalas ka bang gumamit ng internet/computer o gadgets?</label>
                <textarea class="form-control" asp-for="Assessment.ActivitiesInternetGadgetUse" rows="3"></textarea>
            </div>
        </div>

        <!-- DRUGS Section -->
        <div class="form-section">
            <h3>DRUGS</h3>
                
            <div class="mb-3">
                <label class="form-label">Naranasan mo na bang gumamit ng mga sumusunod:</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsTobaccoUse" onchange="updateCheckboxValue('DrugsTobaccoUse', 'Assessment.DrugsTobaccoUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsTobaccoUse" />
                    <label class="form-check-label" for="DrugsTobaccoUse">Tobacco (Sigarilyo)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsAlcoholUse" onchange="updateCheckboxValue('DrugsAlcoholUse', 'Assessment.DrugsAlcoholUse')" />
                    <input type="hidden" asp-for="Assessment.DrugsAlcoholUse" />
                    <label class="form-check-label" for="DrugsAlcoholUse">Alcohol (Alak)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="DrugsStreetDrugs" onchange="updateCheckboxValue('DrugsStreetDrugs', 'Assessment.DrugsStreetDrugs')" />
                    <input type="hidden" asp-for="Assessment.DrugsStreetDrugs" />
                    <label class="form-check-label" for="DrugsStreetDrugs">Street/Prohibited drugs</label>
                </div>
            </div>
        </div>

        <!-- SEXUALITY Section -->
        <div class="form-section">
            <h3>SEXUALITY</h3>
                
            <div class="mb-3">
                <label class="form-label">Nababalisa ka ba tungkol sa iyong kalusugan o mga pagbabago sa katawan?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityHealthConcerns" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay may karanasan na sa pakikipagtalik?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityIntimateRelationships" value="Yes" asp-for="Assessment.SexualityIntimateRelationships" />
                    <label class="form-check-label">Oo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SexualityIntimateRelationships" value="No" asp-for="Assessment.SexualityIntimateRelationships" />
                    <label class="form-check-label">Hindi</label>
                </div>
                <div class="mt-2">
                    <label class="form-label">Kung Oo, ilan na ang nakatalik mo sa nakaraang taon?</label>
                    <input type="text" class="form-control" asp-for="Assessment.SexualityPartnersCount" />
                </div>
            </div>
            
            <!-- Additional sexuality items per paper form -->
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nakaranas nang magbuntis o makabuntis?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityPregnancyExperience" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nagkaroon na ng nakakahawang sakit dulot ng pakikipagtalik?</label>
                <textarea class="form-control" asp-for="Assessment.SexualitySTIExperience" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">May ginagamit ka bang proteksyon kapag sa tuwing nakikipagtalik?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityProtectionUse" rows="2"></textarea>
            </div>
            
            
            
            <div class="mb-3">
                <label class="form-label">May nakaranas ba na magbunot o maglunsad laban sa iyo?</label>
                <textarea class="form-control" asp-for="Assessment.SexualityHarassment" rows="3"></textarea>
            </div>
        </div>

        <!-- SAFETY / WEAPONS / VIOLENCE Section -->
        <div class="form-section">
            <h3>SAFETY / WEAPONS / VIOLENCE</h3>
                
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nakakaranas mahipuan/masuntok/masampal/matulak ng kahit sino?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyPhysicalAbuse" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Nakaranas ka na bang masaktan o takutin ng iyong karelasyon?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyRelationshipViolence" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Gumagamit ka ba ng helmet o protective gear kapag sumasakay ng motor/iba pang sasakyan?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyProtectiveGear" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May kasambahay ka bang nagmamay-ari ng baril o rifle?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyGunsAtHome" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May kasamahan ka bang nagmamay-ari ng baril o rifle?</label>
                <textarea class="form-control" asp-for="Assessment.SafetyWeaponAccess" rows="3"></textarea>
            </div>
        </div>

        <!-- SUICIDE / DEPRESSION Section -->
        <div class="form-section">
            <h3>SUICIDE / DEPRESSION</h3>
                
            <div class="mb-3">
                <label class="form-label">Ikaw ba ay nakaranas na ng matinding pagkabalisa o depresyon?</label>
                <textarea class="form-control" asp-for="Assessment.SuicideDepressionFeelings" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Naisip mo na bang saktan ang sarili o tapusin ang buhay?</label>
                <textarea class="form-control" asp-for="Assessment.SuicideSelfHarmThoughts" rows="3"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label">May miyembro ba ng pamilya na nagtangkang magpakamatay o nakaranas ng matinding depresyon?</label>
                <textarea class="form-control" asp-for="Assessment.SuicideFamilyHistory" rows="3"></textarea>
            </div>
        </div>
        
        <!-- HOPE Line Section -->
        <div class="form-section">
            <h3>HOPE Line (for suicide prevention and emotional crisis)</h3>
            <div class="alert alert-info text-center">
                <strong>📞 804-4673 (HOPE) / 0917-558-4673 (HOPE)</strong>
            </div>
        </div>

        <!-- Notes Section -->
        <div class="form-section">
            <div class="mb-3">
                <label class="form-label">Notes:</label>
                <textarea class="form-control" asp-for="Assessment.Notes" rows="4"></textarea>
            </div>
        </div>

        <!-- Review Section -->
        <div class="form-section">
            <div class="mb-3">
                <label class="form-label">Assessed by:</label>
                <input type="text" class="form-control" asp-for="Assessment.AssessedBy" />
            </div>
        </div>

        <!-- Submit Button -->
        <div class="text-center mt-4">
            <a href="/Nurse/PrintHEEADSSSAssessment?appointmentId=@Model.Assessment.AppointmentId" class="btn btn-success btn-lg me-3" target="_blank">
                <i class="fas fa-print me-2"></i>
                Print Assessment
            </a>
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-save me-2"></i>
                Update Assessment
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <!-- SweetAlert2 for notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Function to update checkbox values
        function updateCheckboxValue(checkboxId, hiddenFieldName) {
            const checkbox = document.getElementById(checkboxId);
            const hiddenField = document.querySelector(`input[name="${hiddenFieldName}"]`);
            if (checkbox && hiddenField) {
                hiddenField.value = checkbox.checked ? "True" : "False";
            }
        }

        // Function to initialize checkbox states from hidden field values
        function initializeCheckboxes() {
            const checkboxes = [
                'IsNHPTS', 'IsPhilHealthBeneficiaryOnly', 'IsOwnPhilHealth',
                'BMIUnderweight', 'BMINormal', 'BMIOverweight', 'BMIObese',
                'EatingVomiting', 'EatingDietPills', 'EatingLaxatives', 'EatingStarvation',
                'DrugsTobaccoUse', 'DrugsAlcoholUse', 'DrugsStreetDrugs'
            ];

            checkboxes.forEach(checkboxId => {
                const hiddenField = document.querySelector(`input[name="Assessment.${checkboxId}"]`);
                const checkbox = document.getElementById(checkboxId);
                if (hiddenField && checkbox) {
                    checkbox.checked = hiddenField.value === "True";
                }
            });
        }

        $(document).ready(function() {
            // Initialize checkboxes on page load
            initializeCheckboxes();

            // BMI Calculation
            $('#Assessment_Height, #Assessment_Weight').on('input', function() {
                const height = parseFloat($('#Assessment_Height').val());
                const weight = parseFloat($('#Assessment_Weight').val());
                
                if (height && weight && height > 0 && weight > 0) {
                    const heightInMeters = height / 100; // Convert cm to meters
                    const bmi = (weight / (heightInMeters * heightInMeters)).toFixed(1);
                    $('#Assessment_BMI').val(bmi);
                    
                    // Auto-select BMI status based on value
                    $('input[name*="BMI"]').prop('checked', false); // Clear all checkboxes
                    
                    if (bmi < 18.5) {
                        $('#BMIUnderweight').prop('checked', true);
                        updateCheckboxValue('BMIUnderweight', 'Assessment.BMIUnderweight');
                    } else if (bmi >= 18.5 && bmi < 25) {
                        $('#BMINormal').prop('checked', true);
                        updateCheckboxValue('BMINormal', 'Assessment.BMINormal');
                    } else if (bmi >= 25 && bmi < 30) {
                        $('#BMIOverweight').prop('checked', true);
                        updateCheckboxValue('BMIOverweight', 'Assessment.BMIOverweight');
                    } else if (bmi >= 30) {
                        $('#BMIObese').prop('checked', true);
                        updateCheckboxValue('BMIObese', 'Assessment.BMIObese');
                    }
                } else {
                    $('#Assessment_BMI').val('');
                }
            });

            // Show/hide female-only section based on gender
            function toggleFemaleSection() {
                // Check if patient is female (you may need to implement gender checking logic)
                const gender = '@Model.Assessment.Gender'.toLowerCase();
                if (gender === 'female' || gender === 'f') {
                    $('#female-only-section').show();
                } else {
                    $('#female-only-section').hide();
                }
            }
            
            // Call function on page load
            toggleFemaleSection();

            // Generate Family Number functionality
            document.getElementById('generate-family-no').addEventListener('click', async function() {
                console.log("Generate button clicked"); // Debug logging
                
                const lastName = document.querySelector('input[name="Assessment.FullName"]').value.split(' ').pop(); // Get last name from patient name
                if (!lastName || lastName.length === 0) {
                    alert('Please enter your last name first to generate a family number.');
                    return;
                }
                
                try {
                    console.log("Sending request to generate family number for:", lastName);
                    const response = await fetch('/User/HEEADSSSAssessment?handler=GenerateFamilyNumber', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: JSON.stringify({ lastName: lastName })
                    });
                    
                    const result = await response.json();
                    console.log("Generate family number response:", result);
                    
                    if (result.success) {
                        console.log("Generated family number:", result.familyNo);
                        document.getElementById('family-no').value = result.familyNo;
                        if (result.isPreexisting) {
                            alert('Using existing family number: ' + result.familyNo);
                        } else {
                            alert('New family number generated: ' + result.familyNo);
                        }
                    } else {
                        alert('Error generating family number: ' + (result.error || 'Unknown error'));
                    }
                } catch (error) {
                    console.error('Error generating family number:', error);
                    alert('Error generating family number. Please try again.');
                }
            });
        });

        
        $(document).ready(function() {
            // Form submission
            $('#heeadsssAssessmentForm').on('submit', function(e) {
                e.preventDefault();
                
                // Update all checkbox values before submission
                const checkboxes = [
                    'IsNHPTS', 'IsPhilHealthBeneficiaryOnly', 'IsOwnPhilHealth',
                    'BMIUnderweight', 'BMINormal', 'BMIOverweight', 'BMIObese',
                    'EatingVomiting', 'EatingDietPills', 'EatingLaxatives', 'EatingStarvation',
                    'DrugsTobaccoUse', 'DrugsAlcoholUse', 'DrugsStreetDrugs'
                ];

                checkboxes.forEach(checkboxId => {
                    const checkbox = document.getElementById(checkboxId);
                    const hiddenField = document.querySelector(`input[name="Assessment.${checkboxId}"]`);
                    if (checkbox && hiddenField) {
                        const newValue = checkbox.checked ? "True" : "False";
                        hiddenField.value = newValue;
                        console.log(`Checkbox ${checkboxId}: ${checkbox.checked} -> ${newValue}`);
                    }
                });
                
                // Show loading
                Swal.fire({
                    title: 'Updating...',
                    text: 'Please wait while we update the assessment.',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    willOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // Debug: Log form data before submission
                const formData = $(this).serialize();
                console.log('Form data being submitted:', formData);
                
                // Submit form using fetch API which handles redirects better
                fetch(window.location.pathname, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: formData,
                    redirect: 'manual' // Don't follow redirects automatically
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    console.log('Response type:', response.type);
                    
                    if (response.status === 0 || response.status === 200 || response.status === 302) {
                        // Success - show success message and redirect
                        Swal.fire({
                            title: 'Success!',
                            text: 'The HEEADSSS assessment has been updated successfully.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            window.location.href = '/Nurse/AppointmentDetails?id=@Model.Assessment.AppointmentId';
                        });
                    } else {
                        // Error
                        Swal.fire({
                            title: 'Error',
                            text: 'An error occurred while updating the assessment. Please try again.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                })
                .catch(error => {
                    console.error('Fetch Error:', error);
                    Swal.fire({
                        title: 'Error',
                        text: 'An error occurred while updating the assessment. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
            });
        });
    </script>
}
